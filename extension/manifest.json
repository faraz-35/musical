{
  "manifest_version": 3,
  "name": "musical — poetic subtitles",
  "version": "0.1.0",
  "description": "Custom romanticized English subtitles for YouTube songs.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
