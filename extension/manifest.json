{
  "manifest_version": 3,
  "name": "musical — poetic subtitles",
  "version": "0.1.0",
  "description": "Custom romanticized English subtitles for YouTube songs.",

  "browser_specific_settings": {
    "gecko": {
      "id": "musical@local",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/faraz-35/musical/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
